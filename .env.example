# Доступ к интерфейсам. Для доступа команды укажите LAN-адрес хоста,
# для работы в одиночку оставьте 127.0.0.1.
BIND_ADDRESS=127.0.0.1
FARM_PORT=8080
NEO_PORT=5005
PACKMATE_PORT=65000
PACKMATE_USERNAME=packmate

# ./control init создает .env со случайными паролями и ключами.
FARM_PASSWORD=
FARM_DB_PASSWORD=
NEO_KEY=
NEO_WORKER_KEY=
PACKMATE_PASSWORD=
PACKMATE_DB_PASSWORD=

# Параметры соревнования задаются вручную. Сверьте их до запуска.
# Адреса команд берутся из targets.txt, FARM_TEAMS здесь не нужен.
# FARM_FLAG_FORMAT - регулярка флага, замените на формат вашего соревнования,
# иначе Neo не найдет флаги, а Farm отклонит их.
FARM_FLAG_FORMAT='[A-Z0-9]{31}='
# FARM_FLAG_LIFETIME - время жизни флага в секундах, как на соревновании.
FARM_FLAG_LIFETIME=300
# FARM_SYSTEM_* выдает организатор. Пока они пустые, флаги копятся в Farm
# и не уходят на борду. После заполнения: ./control farm submit-up
FARM_SYSTEM_PROTOCOL=
FARM_SYSTEM_HOST=
FARM_SYSTEM_PORT=31337
FARM_SYSTEM_URL=
FARM_SYSTEM_TOKEN=
FARM_SYSTEM_VALIDATOR=
FARM_SYSTEM_SERVER_KEY=

# Параллелизм исполнителя Neo.
NEO_WORKER_JOBS=15
NEO_WORKER_ENDLESS_JOBS=0

# Разбор закрытого файла. LIVE настраивается отдельным Compose-файлом Packmate.
# PACKMATE_LOCAL_IP - ваш адрес в игровой сети, по нему Packmate отделяет
# свои сервисы от чужих. Нужен, если разбираете трафик.
PACKMATE_LOCAL_IP=192.0.2.1
PACKMATE_PCAP_FILE=/pcaps/capture.pcap
PACKMATE_MEMORY_LIMIT=2g
PACKMATE_INTERFACE_NAME=
PACKMATE_DB_PORT=65432
